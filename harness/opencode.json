{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark vLLM",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3-coder": {
          "name": "Spark coder (fast)",
          "limit": { "context": 262144, "output": 32768 },
          "options": { "chat_template_kwargs": { "enable_thinking": false } }
        },
        "qwen3-coder-think": {
          "id": "qwen3-coder",
          "name": "Spark coder (thinking)",
          "limit": { "context": 262144, "output": 32768 },
          "options": { "chat_template_kwargs": { "enable_thinking": true } }
        }
      }
    }
  },
  "enabled_providers": ["spark"],
  "permission": {
    "question": "deny",
    "external_directory": {
      "*": "deny",
      "~/.agents/skills/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.agents/skills/**": "deny"
    },
    "doom_loop": "deny"
  },
  "share": "disabled",
  "autoupdate": false,
  "model": "spark/qwen3-coder",
  "small_model": "spark/qwen3-coder",
  "agent": {
    "build": { "temperature": 1.0, "top_p": 0.95 }
  }
}
