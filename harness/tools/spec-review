#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""spec-review: compare a project's spec with its code, in a fresh context, and list the gaps.

Reads the request, the project's spec documents (README.md, SPEC.md, docs/*.md) and its source
files, asks the model behind the Spark's OpenAI-compatible endpoint which concrete requirements the
code does not meet, and prints them. Exit code 0 when the review ran (gaps or not); non-zero only
when there is nothing to review or the model could not be reached.

    spec-review --goal "Build the habits API described in README.md, with tests."

Why a fresh context: the agent that wrote the code reviews it through its own plan and misses the
details its plan dropped (an error code, a trim, a sort tiebreak). A reader that sees only the spec
and the code finds those.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

ENDPOINT = os.environ.get("SPEC_REVIEW_ENDPOINT", "http://127.0.0.1:8000/v1")
MODEL = os.environ.get("SPEC_REVIEW_MODEL", "qwen3-coder")
EFFORT = os.environ.get("SPEC_REVIEW_EFFORT", "medium")
SPEC_BYTES = 40_000
CODE_BYTES = 90_000
SPEC_NAMES = ("README.md", "SPEC.md", "REQUIREMENTS.md")
SOURCE_EXT = {
    ".py",
    ".ts",
    ".tsx",
    ".js",
    ".mjs",
    ".cjs",
    ".jsx",
    ".html",
    ".css",
    ".c",
    ".h",
    ".go",
    ".rs",
    ".sh",
    ".sql",
    ".vue",
    ".svelte",
}
SKIP_DIRS = {
    "node_modules",
    ".git",
    ".venv",
    "venv",
    "dist",
    "build",
    "__pycache__",
    ".supervisor-best",
    ".look",
    ".pytest_cache",
}

PROMPT = """You review whether a code project meets its specification. You did not write the code.

The request the developer was given:
<request>
{goal}
</request>

The specification documents:
{specs}

The project's files:
{code}

Go through the specification and the request line by line. Every concrete, checkable requirement counts:
commands and how the app starts, environment variables, routes and methods, status codes, field names and
types, error formats and codes, validation limits, trimming, defaults, date and number formats, sort order
and tiebreaks, persistence across restarts, UI labels, buttons and behaviour, files that must exist, tests
the request asks for.

For each requirement, find where the code implements it. Report only the requirements the code does NOT
meet, or implements differently from the spec. Each gap must quote the spec text it breaks and point at the
file (and function) where the code differs. Do not report style, missing comments, or extra features. Do
not guess: if you cannot point at the code that breaks the requirement, leave it out.

Answer in exactly this format and nothing else:
GAPS:
- "<quoted spec text>" | <file:function> | <what the code does instead> | <the fix in one line>
(at most 12 lines, most important first)

or, when every requirement is met:
GAPS: none
"""


def read_capped(paths: list[Path], root: Path, budget: int) -> tuple[str, list[str]]:
    parts, left, cut = [], budget, []
    for p in paths:
        try:
            text = p.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        rel = p.relative_to(root).as_posix()
        if len(text) > left:
            cut.append(rel)
            continue
        parts.append(f'<file path="{rel}">\n{text}\n</file>')
        left -= len(text)
    return "\n".join(parts), cut


def spec_files(root: Path) -> list[Path]:
    found = [root / n for n in SPEC_NAMES if (root / n).is_file()]
    docs = root / "docs"
    if docs.is_dir():
        found += sorted(p for p in docs.rglob("*.md") if p.is_file())
    return found


def source_files(root: Path, specs: list[Path]) -> list[Path]:
    try:
        listed = subprocess.run(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
            cwd=root,
            capture_output=True,
            text=True,
            timeout=20,
            check=True,
        ).stdout.split()
        candidates = [root / f for f in listed]
    except (subprocess.SubprocessError, OSError):
        candidates = [
            p
            for p in root.rglob("*")
            if not any(part in SKIP_DIRS or part.startswith(".") for part in p.relative_to(root).parts[:-1])
        ]
    files = [p for p in candidates if p.is_file() and p.suffix in SOURCE_EXT and p not in specs]
    files += [
        p for p in candidates if p.is_file() and p.name in ("package.json", "start.sh", "Makefile", "pyproject.toml")
    ]
    # Code before tests, newest first: when the budget runs out, the oldest tests are the ones left out.
    return sorted(set(files), key=lambda p: ("test" in p.relative_to(root).as_posix().lower(), -p.stat().st_mtime))


def review(goal: str, specs: str, code: str) -> str:
    body = {
        "model": MODEL,
        "messages": [
            {
                "role": "user",
                "content": PROMPT.format(goal=goal, specs=specs or "(none: the request is the spec)", code=code),
            }
        ],
        "max_tokens": 12000,
        "chat_template_kwargs": {"enable_thinking": True, "reasoning_effort": EFFORT},
    }
    req = urllib.request.Request(
        f"{ENDPOINT}/chat/completions", json.dumps(body).encode(), {"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=900) as r:
        return (json.load(r)["choices"][0]["message"]["content"] or "").strip()


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--goal", required=True, help="the request the project was built from")
    ap.add_argument("--root", default=".", help="project directory")
    a = ap.parse_args()
    root = Path(a.root).resolve()
    specs = spec_files(root)
    spec_text, _ = read_capped(specs, root, SPEC_BYTES)
    code_text, cut = read_capped(source_files(root, specs), root, CODE_BYTES)
    if not code_text:
        print("spec-review: no source files to review", file=sys.stderr)
        return 2
    if cut:
        code_text += f"\n(left out for size: {', '.join(cut[:20])})"
    try:
        out = review(a.goal, spec_text, code_text)
    except (urllib.error.URLError, TimeoutError, KeyError, json.JSONDecodeError) as exc:
        print(f"spec-review: model at {ENDPOINT} did not answer: {exc}", file=sys.stderr)
        return 4
    start = out.find("GAPS:")
    print(out[start:] if start >= 0 else out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
